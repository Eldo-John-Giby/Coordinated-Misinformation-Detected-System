import os
import sys

# If running on Kaggle, the project files should be in /kaggle/input/
# or you can clone from a repo
# For this notebook, we assume the project structure exists

# Add project root to path
sys.path.insert(0, os.getcwd())

# ============================================================
# CELL 3: Import Libraries
# ============================================================
import yaml
import torch
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import networkx as nx
from pathlib import Path

print(f"PyTorch version: {torch.__version__}")
print(f"CUDA available: {torch.cuda.is_available()}")
if torch.cuda.is_available():
    print(f"GPU: {torch.cuda.get_device_name(0)}")

# ============================================================
# CELL 4: Configuration
# ============================================================
# Item 25 fix: load the project's configs/config.yaml instead of inlining
# divergent hyperparameters (previously 128 hidden channels / 3 layers vs
# the config's 64 / 2, silently out of sync). Any override you need goes in
# an explicit override dict that is deep-merged on top of the base config.
import yaml

with open("configs/config.yaml", "r") as f:
    config = yaml.safe_load(f)

# Explicit overrides for Kaggle's memory limits - the ONLY divergence from
# the repo config, and visible here rather than hidden in a copy.
config["data"]["max_posts"] = 50000

# Respect the campaign setting below: it selects which dataset is used.
CAMPAIGN = "Armenia"  # change to Honduras / UAE / etc.
config["data"]["campaign"] = CAMPAIGN

USE_SAMPLE = False  # False = use real campaign data (downloaded/uploaded)

# Optional synthetic quick-test: set USE_SAMPLE=True to generate a tagged
# synthetic dataset. Results will carry data_source=synthetic (item 9).
if USE_SAMPLE:
    config["data"]["allow_synthetic_fallback"] = True

print(f"Campaign: {config['data']['campaign']}, sample mode: {USE_SAMPLE}")
print(f"Loaded config: {len(config)} top-level sections from configs/config.yaml")

# ============================================================
# CELL 5: Get Dataset
# ============================================================
# Item 25 fix: data acquisition now follows the notebook's intent.
#
# USE_SAMPLE=False (default): expect real campaign data at data/raw/.
#   Upload the campaign CSVs (converted with
#   `python -m src.data.convert_zenodo --campaign <name>`) to Kaggle as a
#   dataset and point config['data']['raw_dir'] at it, or clone the repo
#   with data included. The pipeline will FAIL LOUDLY if files are missing
#   (item 9) instead of silently generating fake data.
#
# USE_SAMPLE=True: generate the small tagged synthetic sample for a smoke
#   test. Results are marked data_source=synthetic.

os.makedirs("data/raw", exist_ok=True)

if USE_SAMPLE:
    from src.data.loader import create_sample_dataset

    create_sample_dataset(output_dir="data/raw")
    print("Synthetic sample dataset created (tagged as synthetic).")
else:
    from src.data.loader import DataLoader

    files = DataLoader.discover_files(
        config["data"]["raw_dir"], config["data"]["campaign"]
    )
    if not files:
        raise FileNotFoundError(
            f"No CSV files for campaign '{config['data']['campaign']}' in "
            f"{config['data']['raw_dir']}/. Upload the converted campaign "
            "CSVs (see CELL 5 comments) or set USE_SAMPLE=True."
        )
    print(f"Found {len(files)} data file(s) for campaign "
          f"{config['data']['campaign']}:")
    for f_ in files:
        print(f"  {f_}")

# ============================================================
# CELL 6: Run Pipeline
# ============================================================
from src.pipeline import CoordinationDetectionPipeline

pipeline = CoordinationDetectionPipeline(config)
results = pipeline.run(use_sample=USE_SAMPLE)

print("\n" + "="*60)
print("PIPELINE COMPLETE!")
print("="*60)

# ============================================================
# CELL 7: Display Results
# ============================================================
# Model comparison
if "model_comparison" in results:
    print("\n📊 Model Comparison:")
    comp_df = pd.DataFrame([
        {"Model": k, **{mk: f"{mv:.4f}" if isinstance(mv, float) else mv
                       for mk, mv in v.items() if isinstance(mv, (int, float))}}
        for k, v in results["model_comparison"].items()
    ])
    display(comp_df)

# Suspicious groups
if "suspicious_groups" in results:
    print(f"\n🕵️ Suspicious Groups Found: {len(results['suspicious_groups'])}")
    for i, group in enumerate(results["suspicious_groups"][:5]):
        print(f"\nGroup {group.get('group_id', i)}:")
        print(f"  Accounts: {group.get('num_accounts', 0)}")
        print(f"  Coordination Score: {group.get('coordination_score', 0):.3f}")
        print(f"  Suspiciousness: {group.get('suspiciousness_score', 0):.3f}")

# ============================================================
# CELL 8: Visualize Results
# ============================================================
import matplotlib.pyplot as plt
import matplotlib.image as mpimg

# Display generated figures
figures_dir = "results/figures"
if os.path.exists(figures_dir):
    figures = list(Path(figures_dir).glob("*.png"))
    print(f"\n📈 Generated {len(figures)} figures:")
    for fig_path in figures[:6]:  # Show first 6
        print(f"\n{fig_path.name}:")
        img = mpimg.imread(fig_path)
        plt.figure(figsize=(10, 6))
        plt.imshow(img)
        plt.axis('off')
        plt.title(fig_path.stem)
        plt.show()

# ============================================================
# CELL 9: Ablation Study
# ============================================================
if "model_comparison" in results:
    print("\n🔬 Ablation Study Results:")
    # The ablation results would be in the experiment output
    ablation_path = "results/ablation_results.csv"
    if os.path.exists(ablation_path):
        ablation_df = pd.read_csv(ablation_path)
        display(ablation_df)
    else:
        print("Run with experiments.ablation=True to generate ablation study")

print("\n✅ All done! Upload results to Kaggle datasets for sharing.")

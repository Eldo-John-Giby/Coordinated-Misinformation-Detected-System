    print(f"\n📈 Generated {len(figures)} figures:")
    for fig_path in figures[:6]:  # Show first 6
        print(f"\n{fig_path.name}:")
        img = mpimg.imread(fig_path)
        plt.figure(figsize=(10, 6))
        plt.imshow(img)
        plt.axis('off')
        plt.title(fig_path.stem)
        plt.show()

